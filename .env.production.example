# Production environment for infra/docker-compose.prod.yml.
# Copy to .env.production on the VM and fill in REAL, GENERATED secrets —
# never reuse the zenkraft/zenkraft_dev_password defaults from .env.example.
# Generate strong values with: openssl rand -base64 24
#
# This file is consumed by `docker compose --env-file .env.production ...`,
# NOT committed to git (see .gitignore) — it never leaves the VM.

# --- Postgres ---
POSTGRES_USER=zenkraft
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
POSTGRES_DB=zenkraft

# --- Object storage (self-hosted MinIO, fronted by Caddy on media.yourdomain.com) ---
# STORAGE_ENDPOINT/PORT/USE_SSL must be the PUBLIC hostname — the API embeds
# these verbatim into presigned media URLs returned to the browser.
STORAGE_ENDPOINT=media.zenkraftdesignstudio.com
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=CHANGE_ME_STRONG_RANDOM_VALUE
STORAGE_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_VALUE
STORAGE_BUCKET=zenkraft-media
