{
  "name": "zenkraft-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev:apps": "concurrently -n api,web -c blue,magenta \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev": "npm run dev:infra && npm run dev:apps",
    "build": "npm run build --workspace=packages/config && npm run build --workspace=packages/validation && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "seed:contact-config": "tsx scripts/seed-contact-config.ts",
    "seed:demo-content": "tsx scripts/seed-demo-content.ts",
    "seed:demo-media": "tsx scripts/seed-demo-media.ts",
    "validate:production-config": "tsx scripts/validate-production-config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@zenkraft/config": "*",
    "dotenv": "^16.4.7",
    "minio": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
