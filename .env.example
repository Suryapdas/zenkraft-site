# Root env — shared values used by scripts/ (seed, production-config validator) and prisma/
DATABASE_URL="postgresql://zenkraft:zenkraft_dev_password@localhost:5433/zenkraft?schema=public"
NODE_ENV=development

# Object storage (MinIO in dev, S3-compatible in prod)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9002
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=zenkraft
STORAGE_SECRET_KEY=zenkraft_dev_password
STORAGE_BUCKET=zenkraft-media

# Points packages/config at the repo-root config/ directory. Only override for non-standard layouts.
# ZENKRAFT_CONFIG_DIR=../config
