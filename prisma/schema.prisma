generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  CONTENT_MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION
  PROPOSAL
  WON
  LOST
}

enum PreferredContactMethod {
  PHONE
  WHATSAPP
  EMAIL
}

// Phase 2 (admin CMS + RBAC) uses this table; created now to avoid FK
// migration churn later on Lead.ownerId / LeadNote.authorId / AuditLog.actorId.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeads       Lead[]              @relation("LeadOwner")
  leadNotes        LeadNote[]
  auditLogs        AuditLog[]
  contactConfigs   SiteContactConfig[]

  @@map("users")
}

model Lead {
  id                      String                  @id @default(uuid()) @db.Uuid
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  name                    String
  email                   String
  phone                   String
  city                    String
  projectType             String
  budgetRange             String
  timeline                String
  description             String
  preferredContactMethod  PreferredContactMethod
  consentAt               DateTime
  source                  String                  @default("WEBSITE")
  status                  LeadStatus              @default(NEW)
  priority                String?
  ownerId                 String?                 @db.Uuid
  owner                   User?                   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  nextActionAt            DateTime?
  lastContactedAt         DateTime?
  // Extensions beyond data-model.md's summary list, required by FR-006:
  preferredConsultationAt DateTime?
  attachmentStorageKey    String?

  notes LeadNote[]

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  title       String
  category    String
  location    String
  year        Int
  description String
  scope       String

  // content-model.md project block extensions:
  challenge String?
  approach  String?
  outcome   String?

  coverMediaId String?       @unique @db.Uuid
  coverMedia   ProjectMedia? @relation("ProjectCover", fields: [coverMediaId], references: [id])
  media        ProjectMedia[] @relation("ProjectGallery")

  published Boolean @default(false)

  seoTitle        String?
  seoDescription  String?
  seoCanonicalUrl String?
  ogImageUrl      String?
  structuredData  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@map("projects")
}

model ProjectMedia {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation("ProjectGallery", fields: [projectId], references: [id], onDelete: Cascade)
  storageKey String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  coverOfProject Project? @relation("ProjectCover")

  @@index([projectId])
  @@map("project_media")
}

model Service {
  id       String @id @default(uuid()) @db.Uuid
  slug     String @unique
  title    String
  category String
  // "description" = short description, "body" = detailed description (content-model.md)
  description String
  body        String

  deliverables Json?
  process      Json?

  ctaLabel              String?
  ctaUrl                String?
  coverImageStorageKey  String?

  published Boolean @default(false)
  sortOrder Int     @default(0)

  seoTitle        String?
  seoDescription  String?
  seoCanonicalUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("services")
}

// Singleton row: the single live runtime source for GET /contact (FR-002/FR-011),
// seeded from config/business.yaml, editable later via PATCH /admin/contact-config.
model SiteContactConfig {
  id String @id @default(uuid()) @db.Uuid

  phone    String
  whatsapp String
  email    String

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Decimal @db.Decimal(9, 6)
  longitude    Decimal @db.Decimal(9, 6)
  mapUrl       String

  businessHours Json

  addressVerified        Boolean @default(false)
  phoneVerified          Boolean @default(false)
  emailVerified          Boolean @default(false)
  mapPinVerified         Boolean @default(false)
  socialProfilesVerified Boolean @default(false)

  updatedBy     String?  @db.Uuid
  updatedByUser User?    @relation(fields: [updatedBy], references: [id])
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("site_contact_config")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_log")
}

// AC-004 duplicate-submission protection for POST /leads.
model IdempotencyKey {
  key            String   @id
  requestHash    String
  responseStatus Int
  responseBody   Json
  leadId         String?  @db.Uuid
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}
