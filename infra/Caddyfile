# Caddy provisions and renews Let's Encrypt certificates for each site
# below automatically — no manual cert management needed — as long as
# these DNS A records point at the VM's public IP:
#   zenkraftdesignstudio.com
#   www.zenkraftdesignstudio.com
#   api.zenkraftdesignstudio.com
#   media.zenkraftdesignstudio.com

zenkraftdesignstudio.com {
	reverse_proxy web:3000
}

# Canonical apex is zenkraftdesignstudio.com — send www to it with a
# permanent redirect rather than serving the site from two hostnames.
www.zenkraftdesignstudio.com {
	redir https://zenkraftdesignstudio.com{uri} permanent
}

api.zenkraftdesignstudio.com {
	reverse_proxy api:4000
}

# Fronts MinIO so presigned media URLs (generated by the API using
# STORAGE_ENDPOINT=media.zenkraftdesignstudio.com) are reachable by the
# browser over HTTPS. Caddy forwards the original Host header unchanged,
# which MinIO needs to validate the presigned URL's signature.
media.zenkraftdesignstudio.com {
	reverse_proxy minio:9000
}
